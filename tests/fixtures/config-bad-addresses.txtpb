# Addresses that are not an IP literal and a port. Only the last one is a peer.
# The others must not get into ergo.conf.
#
# Text format of a celaut.ConfigurationFile. tests/test_entrypoint.sh encodes it
# with protoc and service/celaut.proto at each run.

gateway {
  api {
    slot {
      port: 8080
      transport { tags: "tcp" }
    }
  }
  uri_slot {
    internal_port: 8080
    uri { ip: "192.168.200.1" port: 8080 }
  }
}
network_resolution {
  tags: "pow:ergo"
  peer_instances {
    api {
      slot {
        port: 9030
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: 9030
      uri { ip: "node.example.org" port: 9030 }
    }
  }
  peer_instances {
    api {
      slot {
        port: 9030
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: 9030
      uri { ip: "1.2.3.4\"] # x" port: 9030 }
    }
  }
  peer_instances {
    api {
      slot {
        port: 70000
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: 70000
      uri { ip: "198.51.100.10" port: 70000 }
    }
  }
  peer_instances {
    api {
      slot {
        port: -1
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: -1
      uri { ip: "198.51.100.11" port: -1 }
    }
  }
  peer_instances {
    api { slot { port: 9030 transport { tags: "tcp" } protocol_stack { tags: "ergo-p2p" } } }
    uri_slot { internal_port: 9030 uri { ip: "198.51.100.12" } }
  }
  peer_instances {
    api {
      slot {
        port: 9030
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: 9030
      uri { ip: "198.51.100.9" port: 9030 }
    }
  }
}

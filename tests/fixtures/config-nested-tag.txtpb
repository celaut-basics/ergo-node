# The tag pow:ergo only in a slot of an other network. Only a tag of the
# resolution itself selects it.
#
# Text format of a celaut.ConfigurationFile. tests/test_entrypoint.sh encodes it
# with protoc and service/celaut.proto at each run.

gateway {
  api {
    slot {
      port: 8080
      transport { tags: "tcp" }
    }
  }
  uri_slot {
    internal_port: 8080
    uri { ip: "192.168.200.1" port: 8080 }
  }
}
network_resolution {
  tags: "dns:example.com"
  peer_instances {
    api { slot { port: 443 transport { tags: "tcp" } protocol_stack { tags: "pow:ergo" } } }
    uri_slot { internal_port: 443 uri { ip: "93.184.216.35" port: 443 } }
  }
}

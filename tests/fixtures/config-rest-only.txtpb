# A peer with a REST slot only. The REST API is not a P2P peer.
#
# Text format of a celaut.ConfigurationFile. tests/test_entrypoint.sh encodes it
# with protoc and service/celaut.proto at each run.

gateway {
  api {
    slot {
      port: 8080
      transport { tags: "tcp" }
    }
  }
  uri_slot {
    internal_port: 8080
    uri { ip: "192.168.200.1" port: 8080 }
  }
}
network_resolution {
  tags: "pow:ergo"
  peer_instances {
    api { slot { port: 9053 transport { tags: "tcp" } protocol_stack { tags: "ergo-rest" } } }
    uri_slot { internal_port: 9053 uri { ip: "198.51.100.8" port: 9053 } }
  }
}

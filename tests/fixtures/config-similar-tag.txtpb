# A tag that starts with pow:ergo is a different network.
#
# Text format of a celaut.ConfigurationFile. tests/test_entrypoint.sh encodes it
# with protoc and service/celaut.proto at each run.

gateway {
  api {
    slot {
      port: 8080
      transport { tags: "tcp" }
    }
  }
  uri_slot {
    internal_port: 8080
    uri { ip: "192.168.200.1" port: 8080 }
  }
}
network_resolution {
  tags: "pow:ergo-testnet"
  peer_instances {
    api {
      slot {
        port: 9023
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: 9023
      uri { ip: "192.0.2.1" port: 9023 }
    }
  }
}
network_resolution {
  tags: "pow:ergo"
  peer_instances {
    api {
      slot {
        port: 9030
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: 9030
      uri { ip: "198.51.100.7" port: 9030 }
    }
  }
}

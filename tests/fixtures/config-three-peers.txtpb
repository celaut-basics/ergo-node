# The usual case. A pow:ergo resolution with three peers, the resolution of an
# other network and the gateway. The other network and the gateway also contain
# uri blocks. The second peer has the full shape of a Gateway.ResolveNetwork answer:
# a P2P slot and a REST slot. Only the P2P address is a peer.
#
# Text format of a celaut.ConfigurationFile. tests/test_entrypoint.sh encodes it
# with protoc and service/celaut.proto at each run.

gateway {
  api {
    slot {
      port: 8080
      transport { tags: "tcp" }
    }
  }
  uri_slot {
    internal_port: 8080
    uri { ip: "192.168.200.1" port: 8080 }
  }
}
config {
  environment_variables { key: "ERGO_API_KEY" value: "not-a-peer" }
}
network_resolution {
  tags: "dns:example.com"
  peer_instances {
    api { slot { port: 443 transport { tags: "tcp" } } }
    uri_slot { internal_port: 443 uri { ip: "93.184.216.34" port: 443 } }
  }
}
network_resolution {
  tags: "pow:ergo"
  peer_instances {
    api {
      slot {
        port: 9030
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: 9030
      uri { ip: "213.239.193.208" port: 9030 }
    }
  }
  peer_instances {
    api {
      slot {
        port: 9030
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
      slot {
        port: 9053
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-rest" }
      }
    }
    uri_slot {
      internal_port: 9030
      uri { ip: "159.65.11.55" port: 9030 }
    }
    uri_slot {
      internal_port: 9053
      uri { ip: "159.65.11.55" port: 9053 }
    }
  }
  peer_instances {
    api {
      slot {
        port: 29031
        transport { tags: "tcp" }
        protocol_stack { tags: "ergo-p2p" }
      }
    }
    uri_slot {
      internal_port: 29031
      uri { ip: "2001:41d0:700:6662::1" port: 29031 }
    }
  }
}
initial_sysresources { mem_limit: 4000000000 }
